#--------------------------------------------------------------------
# CaseTech Oilfield CMS — environment configuration template
#
# Copy this file to `.env` and fill in real values. `.env` is never
# committed (see .gitignore) and, per docs/deployment.md, production's
# `.env` lives only in `shared/.env` on the server — it is provisioned
# once and never overwritten by a deploy.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = true

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = casetech_cms
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

database.tests.hostname = localhost
database.tests.database = casetech_cms_test
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
# Used to encrypt SMTP passwords, OAuth tokens, and other `site_settings`
# rows flagged is_secret (see docs/database-schema.md §16).
# Generate with: php spark key:generate
#--------------------------------------------------------------------

encryption.key =

#--------------------------------------------------------------------
# SESSION
# Database-backed sessions — see docs/architecture.md §7 (avoids one
# file per session on inode-constrained shared hosting).
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.savePath = 'ci_sessions'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4

#--------------------------------------------------------------------
# MAIL / SMTP DEFAULTS
# The admin-facing values live in the `site_settings` table
# (Settings → SMTP) and are editable without redeploying; these env
# vars are only the bootstrap fallback used before the admin has
# configured SMTP through the CMS, and by the CLI test-email command.
#--------------------------------------------------------------------

MAIL_SMTP_HOST =
MAIL_SMTP_PORT = 587
MAIL_SMTP_ENCRYPTION = tls
MAIL_SMTP_USERNAME =
MAIL_SMTP_PASSWORD =
MAIL_FROM_EMAIL = casetechoilfield@gmail.com
MAIL_FROM_NAME = "CASETECH Oilfield Services"

#--------------------------------------------------------------------
# CAPTCHA
# Secret keys only — site/public keys are safe to expose and are
# stored in site_settings so they can be changed without a deploy.
#--------------------------------------------------------------------

TURNSTILE_SECRET_KEY =
RECAPTCHA_SECRET_KEY =

#--------------------------------------------------------------------
# GOOGLE DRIVE BACKUP (OAuth 2.0 client — see docs/backup-architecture.md)
#--------------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID =
GOOGLE_OAUTH_CLIENT_SECRET =
GOOGLE_OAUTH_REDIRECT_URI = 'http://localhost:8080/admin/settings/backups/google-drive/callback'
